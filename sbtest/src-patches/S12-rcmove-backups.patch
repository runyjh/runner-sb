+/**
+ * 노선 이관 때 같이 옮긴 백업 기사의 칸 (잠금 안에서 · 적용일부터):
+ *  캠프 이름 없이 적힌 노선은 그 기사 줄의 캠프 기준이라, 캠프가 바뀌면 뜻이 바뀐다.
+ *  옮긴 번호(404ABC)는 새 번호(204ABC)로 · 그 밖의 옛 캠프 노선(410AB)은 '옛캠프 410AB' 로 · 캠프 이름이 적힌 칸·휴무·메모는 그대로
+ *  → 바꾼 칸 수
+ */
+function rcBackupCells_(ids, date, fromCampName, fromNum, toNum) {
+  if (!ids.length || !props_().SCH_DB_ID || !schSS_().getSheetByName(SCH.SHEET)) return 0;
+  const h = schHeader_(), sh = schSheet_(), last = sh.getLastRow();
+  const days = Object.keys(h.dates).filter(function (d) { return d >= date; });
+  if (last < 2 || !days.length) return 0;
+  const pre = str_(fromCampName).replace(/\s*캠프\s*$/, '').replace(/\s+/g, '');
+  const has = new RegExp('(^|[^0-9])' + fromNum + '(?=[A-Za-z])'), swap = function (t) { return str_(t).replace(new RegExp('(^|[^0-9])' + fromNum + '(?=[A-Za-z])', 'g'), '$1' + toNum); };
+  const rowIds = sh.getRange(2, h.fixed['행ID'] + 1, last - 1, 1).getValues().map(function (r) { return str_(r[0]); });
+  const cols = days.map(function (d) { return h.dates[d]; }), c0 = Math.min.apply(null, cols), c1 = Math.max.apply(null, cols);
+  let n = 0;
+  ids.forEach(function (id) {
+    const i = rowIds.indexOf(str_(id));
+    if (i < 0) return;
+    const rng = sh.getRange(i + 2, c0 + 1, 1, c1 - c0 + 1), vals = rng.getValues()[0];
+    let changed = false;
+    days.forEach(function (dt) {
+      const k = h.dates[dt] - c0, v = vals[k] instanceof Date ? '' : str_(vals[k]);
+      if (!v) return;
+      const nv = v.split(/\r?\n/).map(function (ln) {
+        if (!/^\s*\d{3,4}[A-Za-z]/.test(ln)) return ln; // 캠프 이름이 적힌 칸 · 휴무 · 메모는 그대로
+        return has.test(ln) ? swap(ln) : pre + ' ' + ln.trim();
+      }).join('\n');
+      if (nv !== v) { vals[k] = nv; changed = true; n++; }
+    });
+    if (changed) rng.setValues([vals]);
+  });
+  return n;
+}
 /**
  * 노선 이관 뒤 맞추기 (잠금 안에서 · dry 면 목록만):
  *  (1) 적용일에 옛 캠프에서 옛 번호를 아직 맡고 있는 기사 → 그 번호만 새 번호로 노선 변경 (skipDrivers 면 건너뜀)
