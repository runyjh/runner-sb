+}
+/** 기사앱: 내 배번호 진행 — 알릴 것이 있을 때만 항목이 온다 (등기 주소 안내를 받았거나 · 최종 서류를 내야 하거나) */
+function api_bibMine(token) {
+  return run_(function () {
+    const u = pmUser_(token);
+    const m = bibMailInfo_();
+    const items = readAll_(SH.BIB).filter(function (o) { return o.id && String(o.driverId) === u.id; }).map(function (o) {
+      if (o.status === BST.FINAL) return { id: o.id, step: 'final', plateNo: o.plateNo, docs: bibFinalDocs_(o), at: o.finalNotiAt || o.approvedAt };
+      if ((o.status === BST.PRINTED || o.status === BST.SUBMITTED) && o.mailNotiAt) return { id: o.id, step: 'mail', zip: m.zip, addr: m.addr, at: o.mailNotiAt, sent: o.status === BST.SUBMITTED };
+      return null;
+    }).filter(Boolean);
+    return { ok: true, items: items, labels: BIB_FINAL.map(function (f) { return [f[0], f[2]]; }) };
+  });
+}
+/** 기사앱: 최종 서류 한 개 올리기 (본인 신청서 · 최종서류 단계만) */
+function api_bibDocUp(token, id, key, file) {
+  return run_(function () {
+    const u = pmUser_(token);
+    const lock = scriptLock_(); lock.waitLock(20000);
+    try {
+      const app = bibById_(id);
+      if (!app || String(app.driverId) !== u.id) fail_('신청서를 찾을 수 없습니다.');
+      if (app.status !== BST.FINAL) fail_('지금은 서류를 올릴 수 없습니다. 사무실에 문의해 주세요.');
+      const d = driverById_(u.id); if (!d) fail_('기사 정보를 찾을 수 없습니다.');
+      bibSaveDoc_(app, d, key, file);
+      const now = readObj_(SH.BIB, app._row);
+      return { ok: true, docs: bibFinalDocs_(now), all: bibFinalAll_(now) };
+    } finally { lock.releaseLock(); }
+  });
+}
