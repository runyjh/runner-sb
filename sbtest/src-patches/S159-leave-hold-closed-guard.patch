 }
 /**
  * (S157) 보류금 반환 달: 퇴사월 m 다음 달부터 본인 배송이 있는 달은 반환을 다음 달로 미룬다 → 반환 = 퇴사월 다음 달부터 처음으로 본인 배송이 없는 달
  *  month: 지금 계산하는 달 · curDel: 이 달 본인 배송 있음 → { pay, late(미뤘다 주는 것), hold(이 달 배송 때문에 미룸), cap(6달째) }
- *  사이 달 중 배송이 없던 달(그때 반환함)이나 이미 반환이 나간 마감 달이 있으면 다시 주지 않는다 · 퇴사월에서 6달이 지나면 더 보지 않음
+ *  사이 달 중 배송이 없던 달(그때 반환함) · 미룸 기록 없이 마감한 달(그때 반환했거나 예전 방식)이 있으면 다시 주지 않는다 · 퇴사월에서 6달이 지나면 더 보지 않음
  */
 function stlLeaveReturn_(m, month, gid, X, ctx, kinds, curDel) {
   if (!(month > m)) return { pay: false };
   let k = stlAddMonth_(m, 1), n = 1;
   while (k < month) {
     if (n >= 6) return { pay: false };
-    if (!stlOwnDel_(k, gid, X, ctx, kinds) || stlLeavePaidIn_(k, gid)) return { pay: false };
+    if (stlClosedInfo_(k)) { if (!stlLeaveHeldIn_(k, gid)) return { pay: false }; } // 마감한 달: 그 달에 미뤘다고 기록돼 있을 때만 이어서 봄
+    else if (!stlOwnDel_(k, gid, X, ctx, kinds)) return { pay: false }; // 마감 안 한 달: 그 달 본인 배송이 없었으면 그 달에 반환했음
     k = stlAddMonth_(k, 1); n++;
   }
   if (curDel) return n >= 6 ? { pay: true, late: true, cap: true } : { pay: false, hold: true };
