+/**
+ * (S148) 기사앱 읽기 묶음: 앱을 열 때 한꺼번에 나가는 읽기 요청(10~20개)을 한 번에 받는다 (기사앱 gsCall1 이 30ms 안에 모인 것을 묶어 보냄)
+ *  - 수파베이스 서버는 요청을 한 번에 하나씩 처리 → 따로 보내면 앞 요청이 끝날 때까지 뒤 요청이 줄 서서 기다리고, 요청마다 DB 확인 · 왕복이 붙음
+ *  - 읽기 전용(임시 기억만 씀)만 · 각 함수가 자기 토큰을 그대로 확인 · 하나가 실패해도 나머지는 그대로 · 결과는 보낸 순서대로
+ */
+const API_BATCH_OK = ['api_checkSession', 'api_pmAlerts', 'api_notices', 'api_mySchedule', 'api_campSchedule', 'api_myInfo', 'api_myPeak', 'api_myVol', 'api_pmList', 'api_pmMine',
+  'api_uiText', 'api_bdRecent', 'api_myPerf', 'api_myFb', 'api_myFake'];
+function api_batch(token, calls) {
+  const t0 = Date.now();
+  calls = Array.isArray(calls) ? calls.slice(0, BATCH_MAX) : [];
+  const res = calls.map(function (c) {
+    const fn = String(c && c.fn || '');
+    if (API_BATCH_OK.indexOf(fn) < 0 || typeof GLOBAL_[fn] !== 'function') return { ok: false, code: 'NOBATCH', msg: '묶어 보낼 수 없는 요청' };
+    _curFn = fn;
+    try { const r = GLOBAL_[fn].apply(null, Array.isArray(c.args) ? c.args : [token]); return r === undefined ? null : r; }
+    catch (e) { try { errLog_('서버 오류', fn, '묶음: ' + String(e && e.message || e)); } catch (x) { /* 무시 */ } return { ok: false, msg: '처리 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.' }; }
+  });
+  _curFn = 'api_batch';
+  return { ok: true, res: res, _ms: Date.now() - t0 };
+}
