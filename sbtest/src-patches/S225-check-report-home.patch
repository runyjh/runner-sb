+
+// ───────── (S225) 매일 자동 점검 보고 ─────────
+// 새벽 자동 점검(예약 작업)이 스크립트 속성 CHECK_REPORTS 에 넣어 둔 보고를 올인원 홈에서 보여 줌 (최신이 앞 · 최근 30일)
+//  한 건 = { d: 'YYYY-MM-DD', sum: 한 줄 요약, urgent: 급한 것, up: [올린 것], wait: [「올려」만 하면 되는 것], left: [남은 것], miss: [못 한 것], done: 본 항목 수, total: 전체 항목 수, nums: 숫자 한 줄 }
+function chkReports_() {
+  let a = [];
+  try { a = JSON.parse(PropertiesService.getScriptProperties().getProperty('CHECK_REPORTS') || '[]') || []; } catch (e) { a = []; }
+  const L = function (v) { return (Array.isArray(v) ? v : []).slice(0, 20).map(function (x) { return String(x == null ? '' : x).slice(0, 300); }).filter(function (x) { return x; }); };
+  return (Array.isArray(a) ? a : []).filter(function (x) { return x && /^\d{4}-\d{2}-\d{2}$/.test(String(x.d || '')); })
+    .sort(function (x, y) { return String(y.d).localeCompare(String(x.d)); }).slice(0, 30)
+    .map(function (x) { return { d: String(x.d), sum: String(x.sum || '').slice(0, 300), urgent: String(x.urgent || '').slice(0, 300), up: L(x.up), wait: L(x.wait), left: L(x.left), miss: L(x.miss), done: Math.max(0, Number(x.done) || 0), total: Math.max(0, Number(x.total) || 0), nums: String(x.nums || '').slice(0, 300) }; });
+}
+function chkLatest_() {
+  const a = chkReports_(); if (!a.length) return null;
+  const x = a[0];
+  return { d: x.d, sum: x.sum, urgent: x.urgent, up: x.up.length, wait: x.wait.length, left: x.left.length, done: x.done, total: x.total };
+}
+function adm_checkReports(token) {
+  return run_(function () {
+    requireAdmin_(token);
+    return { ok: true, rows: chkReports_() };
+  });
+}
