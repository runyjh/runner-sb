+/**
+ * 쿠팡 정산 일정 메일 → 업무스케줄 (S24)
+ *  - 쿠팡(grp_cls_quick_pay@coupangls.com)이 매달 보내는 '퀵플렉스 수수료 정산 일정 안내' 메일의 표(일자 · 내용 · 비고)와
+ *    '정산서 수정접수 기한' 줄을 읽어 업무스케줄에 날짜별로 넣는다 (적은 사람 '쿠팡 메일').
+ *  - 기한(정산서 수정접수 · 역발행 승인 기한)은 📌 항상 보기(빨강)로 → 기사스케줄 위에도 보이고, 기한이 지나면 빠진다.
+ *  - 같은 정산월을 다시 받으면(정정 메일 · 붙여넣기) 예전에 넣은 메모를 지우고 새로 넣는다. 같은 메일은 한 번만.
+ *  - 메일 수집기가 본문을 보내거나(api_mailBody) · 관리자가 메일 내용을 붙여 넣는다(adm_cpStlPaste).
+ */
+const CPS_PROP = 'CP_STL_SCHED', CPS_AUTHOR = '쿠팡 메일', CPS_TAG = '[쿠팡 정산] ';
+
+/** 메일 본문 html → 글자 (표 칸은 ' | ' · 줄은 줄바꿈) */
+function cpsText_(html) {
+  let s = String(html || '');
+  if (!/<[a-z!\/][^>]*>/i.test(s)) return s.replace(/\r\n?/g, '\n').replace(/\t+/g, ' | ');
+  s = s.replace(/<(style|script)[\s\S]*?<\/\1>/gi, ' ')
+    .replace(/<br\s*\/?>/gi, '\n').replace(/<\/(p|div|tr|li|h\d|table)>/gi, '\n').replace(/<\/t[dh]>/gi, ' | ')
+    .replace(/<[^>]+>/g, ' ')
+    .replace(/&nbsp;/g, ' ').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'")
+    .replace(/&#(\d+);/g, function (m, d) { return String.fromCharCode(+d); }).replace(/&amp;/g, '&');
+  return s.replace(/\r\n?/g, '\n');
+}
+const cpsPad_ = function (n) { return ('0' + n).slice(-2); };
+
+/**
+ * 글자 → { ym, year, rows: [{ date, what, note, pin }], fix: { from, to, time } | null }
+ *  ym: 'yyyy-MM' 정산월 (제목 · 본문의 '26년 11월') · 표의 날짜는 정산월 앞뒤로 연도를 붙인다 (12월 정산의 1월 날짜는 다음 해)
+ */
+function cpsParse_(text, subject, mailDate) {
+  const t = cpsText_(text), head = String(subject || '') + '\n' + t.slice(0, 600);
+  let y = 0, mo = 0;
+  const mh = head.match(/(\d{2,4})\s*년\s*(\d{1,2})\s*월/);
+  if (mh) { y = +mh[1] < 100 ? 2000 + +mh[1] : +mh[1]; mo = +mh[2]; }
+  if (!y) { const md = String(mailDate || '').match(/^(\d{4})-(\d{2})/); if (md) { y = +md[1]; mo = +md[2]; } }
+  if (!y || !mo || mo > 12) return null;
+  const yearOf = function (m) { return m < mo - 6 ? y + 1 : m > mo + 6 ? y - 1 : y; };
+  // 표: 'MM.DD (요일)' 로 시작하는 칸마다 그다음 날짜(또는 표 끝)까지가 내용 · 비고
+  const body = t.split(/\n\s*\*\s*정산서\s*수정접수|\n\s*2\s*\.\s*정산자료/)[0];
+  const re = /(?:^|[\s|])(\d{1,2})\s*[.\/]\s*(\d{1,2})\s*\(\s*([월화수목금토일])\s*(?:요일)?\s*\)/g;
+  const hits = []; let m;
+  while ((m = re.exec(body)) !== null) hits.push({ i: m.index, end: re.lastIndex, mo: +m[1], d: +m[2] });
+  const rows = [];
+  hits.forEach(function (h, k) {
+    const chunk = body.slice(h.end, k + 1 < hits.length ? hits[k + 1].i : body.length);
+    const parts = chunk.split('|').map(function (x) { return x.replace(/\s+/g, ' ').trim(); }).filter(Boolean);
+    if (!parts.length) return;
+    const what = parts[0].replace(/\s*\(\s*/g, ' (').replace(/\s*\)/g, ')'), note = parts.slice(1).join(' · ');
+    const yy = yearOf(h.mo), dt = new Date(yy, h.mo - 1, h.d);
+    if (dt.getMonth() !== h.mo - 1) return;
+    rows.push({ date: yy + '-' + cpsPad_(h.mo) + '-' + cpsPad_(h.d), what: what.slice(0, 120), note: note.slice(0, 200), pin: /기한/.test(what) });
+  });
+  // 정산서 수정접수 기한 : 11월 28일 ~ 12월 03일 오후 12시까지
+  let fix = null;
+  const mf = t.match(/수정\s*접수\s*기한\s*[:：]?\s*(\d{1,2})\s*월\s*(\d{1,2})\s*일\s*~\s*(\d{1,2})\s*월\s*(\d{1,2})\s*일\s*(오전|오후)?\s*(\d{1,2})?\s*시?/);
+  if (mf) {
+    let hh = mf[6] ? +mf[6] : 0; if (mf[5] === '오후' && hh && hh < 12) hh += 12;
+    fix = { from: yearOf(+mf[1]) + '-' + cpsPad_(+mf[1]) + '-' + cpsPad_(+mf[2]), to: yearOf(+mf[3]) + '-' + cpsPad_(+mf[3]) + '-' + cpsPad_(+mf[4]), time: mf[6] ? cpsPad_(hh) + ':00' : '' };
+  }
+  return { ym: y + '-' + cpsPad_(mo), year: y, rows: rows, fix: fix };
+}
+/** 'M/D (요일)' */
+function cpsMd_(d) { const p = String(d).split('-'), dt = new Date(+p[0], +p[1] - 1, +p[2]); return (+p[1]) + '/' + (+p[2]) + ' (' + '일월화수목금토'.charAt(dt.getDay()) + ')'; }
+function cpsGet_() { try { return JSON.parse(props_()[CPS_PROP] || 'null'); } catch (e) { return null; } }
+/** 업무스케줄에 넣기: 같은 정산월에 예전에 넣은 메모는 지우고 새로 */
+function cpsSave_(P, src) {
+  const old = cpsGet_(), a = { name: CPS_AUTHOR }, ids = [];
+  if (old && old.ym === P.ym) (old.memoIds || []).forEach(function (id) { try { memoDelete_(id); } catch (e) { /* 이미 지워짐 */ } });
+  const mon = +P.ym.slice(5);
+  P.rows.forEach(function (r) {
+    const content = CPS_TAG + mon + '월 ' + r.what + (r.note ? ' — ' + r.note : '');
+    const m = { date: r.date, content: content.slice(0, 1900) };
+    if (r.pin) Object.assign(m, { pin: true, until: r.date, color: '빨강' });
+    ids.push(memoSave_(a, m).memo.id);
+  });
+  if (P.fix) {
+    const m = { date: P.fix.to, time: P.fix.time || '', content: CPS_TAG + mon + '월 정산서 수정접수 기한 — ' + cpsMd_(P.fix.from) + ' ~ ' + cpsMd_(P.fix.to) + (P.fix.time ? ' ' + P.fix.time + '까지' : '까지') + ' (메일로 요청)', pin: true, until: P.fix.to, color: '빨강' };
+    ids.push(memoSave_(a, m).memo.id);
+  }
+  const keep = { ym: P.ym, rows: P.rows, fix: P.fix, memoIds: ids, msgId: src.msgId || '', by: src.by || '', at: nowText_(), subject: src.subject || '' };
+  PropertiesService.getScriptProperties().setProperty(CPS_PROP, JSON.stringify(keep)); _props = null;
+  try { rcvBump_('memo'); } catch (e) { /* 캐시 */ }
+  return keep;
+}
+function cpsView_(k) { return k ? { ym: k.ym, rows: k.rows || [], fix: k.fix || null, at: k.at, by: k.by, n: (k.memoIds || []).length } : null; }
+
+/** 수집기 → 올인원: 정산 일정 메일 본문. f = { msgId, from, subject, date, html } */
+function api_mailBody(key, f) {
+  return run_(function () {
+    const cfg = mailCfg_();
+    if (!cfg.hash || !key || sha256b64_(String(key)) !== cfg.hash) return { ok: false, code: 'KEY', msg: '수집 키가 맞지 않습니다.' };
+    if (!cfg.on) return { ok: false, code: 'OFF', msg: '자동 수집이 꺼져 있습니다.' };
+    f = f || {};
+    const msgId = str_(f.msgId).slice(0, 80), from = str_(f.from).slice(0, 120), subject = str_(f.subject).slice(0, 160);
+    const base = { at: nowText_(), from: from, subject: subject, mailAt: str_(f.date).slice(0, 30), file: '(메일 본문)', msgId: msgId, kind: '정산 일정' };
+    if (!/coupangls\.com/i.test(from) || !/정산\s*일정/.test(subject)) return { ok: true, status: MAIL_ST.SKIP };
+    const old = cpsGet_();
+    if (msgId && old && old.msgId === msgId) return { ok: true, status: '이미 처리', dup: true };
+    const P = cpsParse_(String(f.html || '').slice(0, 400000), subject, str_(f.date));
+    if (!P || P.rows.length < 2) { mailLog_(Object.assign(base, { status: MAIL_ST.HOLD, detail: '표를 읽지 못했습니다 (정산관리에서 메일 내용을 붙여 넣어 주세요)' })); return { ok: true, status: MAIL_ST.HOLD }; }
+    const k = cpsSave_(P, { msgId: msgId, by: CPS_AUTHOR, subject: subject });
+    mailLog_(Object.assign(base, { status: MAIL_ST.SAVED, period: P.ym, detail: '업무스케줄 ' + k.memoIds.length + '건' }));
+    return { ok: true, status: MAIL_ST.SAVED, period: P.ym };
+  });
+}
+/** 관리자: 메일 내용을 붙여 넣어 정산 일정 넣기 (수집기가 못 읽었거나 설치 전) */
+function adm_cpStlPaste(token, text) {
+  return run_(function () {
+    const a = requireAdmin_(token);
+    const P = cpsParse_(String(text || '').slice(0, 200000), '', ymd_(new Date()));
+    if (!P || P.rows.length < 2) fail_('정산 일정 표를 찾지 못했습니다. 메일의 「1.정산일정」 표부터 「수정접수 기한」 줄까지 복사해 붙여 넣어 주세요.');
+    const k = cpsSave_(P, { by: a.name + ' (붙여넣기)' });
+    logAdmin_(a, '쿠팡 정산 일정', P.ym, k.memoIds.length + '건');
+    return { ok: true, sched: cpsView_(k) };
+  });
+}
+/** 관리자: 지금 들어 있는 정산 일정 (정산관리 위 한 줄) */
+function adm_cpStlSched(token) {
+  return run_(function () { requireAdmin_(token); return { ok: true, sched: cpsView_(cpsGet_()) }; });
+}
