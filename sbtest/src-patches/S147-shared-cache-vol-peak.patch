diff --git a/src/Settle.gs b/src/Settle.gs
index 6a1da46..a3097d1 100644
--- a/src/Settle.gs
+++ b/src/Settle.gs
@@ -293,6 +293,24 @@ function stlCPut_(key, obj, sec) {
     cache_().putAll(put, sec);
   } catch (e) { /* 캐시 실패해도 결과는 그대로 */ }
 }
+/**
+ * (S147) 여러 서버가 같이 쓰는 임시 기억: 4,000자 조각으로 나눠 넣는다 (읽기는 stlCGet_ 그대로)
+ *  수파베이스판은 4,096자 넘는 값은 그 서버 메모리에만 두고 DB(sb_cache)로 보내지 않는다 → 새 서버가 뜰 때마다 다시 계산했음
+ *  (예: 노선별 하루 평균 = 정산 원본 3만 줄을 통째로 받아 계산 · 기사앱 피크 물량 · 평균 수량이 2~13초)
+ *  모든 사람이 같이 쓰는 작은 결과(노선 평균 · 피크 물량)에만 쓴다 — 기사별 · 큰 결과는 그대로 stlCPut_
+ */
+function shCPut_(key, obj, sec) {
+  const json = JSON.stringify(obj), CH = 4000;
+  if (json.length > CH * 60) return stlCPut_(key, obj, sec);
+  try {
+    if (json.length <= CH) { cache_().put(key, json, sec); return; }
+    const put = {};
+    let i = 0;
+    for (let p = 0; p < json.length; p += CH) put[key + ':' + (i++)] = json.slice(p, p + CH);
+    put[key] = '#' + i;
+    cache_().putAll(put, sec);
+  } catch (e) { /* 캐시 실패해도 결과는 그대로 */ }
+}
