+/** 공유용 글 (ACM 양식) */
+function cmText_(x) {
+  return '신규입차 Commit' + (x.kind === 'back' ? ' (2주 미입차 후 복귀)' : '') + '\n기사ID: ' + x.loginId + '\nPDD 입차예정일: ' + x.date + '\nWAVE/CAMP : ' + x.wave + ' / ' + x.camp;
+}
+function adm_cmList(token) {
+  return run_(function () {
+    requireAdmin_(token);
+    const r = cmList_();
+    r.items.forEach(function (x) { x.text = cmText_(x); });
+    return Object.assign({ ok: true }, r);
+  });
+}
+/** 관리자: 보냄 표시 (keys = ['기사ID|날짜']) · undo 면 보냄 취소 */
+function adm_cmSent(token, keys, undo) {
+  return run_(function () {
+    const a = requireAdmin_(token);
+    const m = cmSent_(), now = Date.now(), cut = now - 90 * 86400000;
+    Object.keys(m).forEach(function (k) { if (m[k] < cut) delete m[k]; });
+    (keys || []).slice(0, 200).forEach(function (k) { k = str_(k); if (!/^[^|]+\|\d{4}-\d{2}-\d{2}$/.test(k)) return; if (undo) delete m[k]; else m[k] = now; });
+    PropertiesService.getScriptProperties().setProperty(CM.PROP, JSON.stringify(m)); _props = null;
+    logAdmin_(a, undo ? '신규입차 Commit 보냄 취소' : '신규입차 Commit 보냄', '', (keys || []).length + '건');
+    return { ok: true, at: now };
+  });
+}
