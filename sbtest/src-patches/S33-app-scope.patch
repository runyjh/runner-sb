     const standalone = (window.matchMedia && matchMedia('(display-mode: standalone)').matches) || navigator.standalone === true;
     // 설치했다고 본 기기 (S32): 설치한 앱으로 한 번이라도 열었거나 설치 완료 신호를 받은 기기 → 브라우저로 열어도 설치 버튼을 안 보임
     //   (안드로이드는 설치 앱과 브라우저가 기억을 같이 씀 · 다시 설치 창 신호가 오면 = 지운 것 → 다시 보임)
-    const INST_K = 'runner.admInstalled'; // 기사앱과 주소(기억 공간)가 같아서 이름을 따로
