+function infoImport_(a) {
+  const P = PropertiesService.getScriptProperties();
+  if (!P.getProperty('INFO_IMPORT')) return 0;
+  const lock = scriptLock_(); if (!lock.tryLock(10000)) return 0;
+  const out = [];
+  try {
+    let job = []; try { job = JSON.parse(P.getProperty('INFO_IMPORT') || '[]') || []; } catch (e) { job = []; }
+    P.deleteProperty('INFO_IMPORT'); _props = null; // 민감 정보는 읽자마자 지운다
+    const all = readAll_(SH.DRIVERS).filter(function (o) { return o.id && o.name; });
+    const OK = ['phone', 'address', 'rrn', 'qualDate', 'qualNo', 'licenseNo', 'licenseType', 'carNo', 'carName', 'carYear', 'maxLoad', 'bankName', 'account', 'accountHolder'];
+    job.forEach(function (j) {
+      const hit = all.filter(function (o) { return str_(o.name).replace(/\s+/g, '') === str_(j.name).replace(/\s+/g, ''); });
+      if (hit.length !== 1) { out.push(j.name + ' · ' + (hit.length ? '같은 이름 ' + hit.length + '명 — 넣지 않음' : '기사 없음')); return; }
+      const o = driverById_(hit[0].id), ch = {};
+      OK.forEach(function (k) { const v = str_((j.fields || {})[k]); if (v && !str_(o[k])) ch[k] = v; });
+      const keys = Object.keys(ch); if (!keys.length) { out.push(j.name + ' · 채울 빈 칸 없음'); return; }
+      const done = [], bad = [];
+      try { updateDriverCore_(a, o.id, ch); done.push.apply(done, keys); }
+      catch (e) { keys.forEach(function (k) { const one = {}; one[k] = ch[k]; try { updateDriverCore_(a, o.id, one); done.push(k); } catch (e2) { bad.push(k); } }); }
+      out.push(j.name + ' · ' + done.length + '칸' + (bad.length ? ' · 못 넣음 ' + bad.join(',') : ''));
+    });
+    let log = []; try { log = JSON.parse(P.getProperty('INFO_IMPORT_LOG') || '[]') || []; } catch (e) { log = []; }
+    P.setProperty('INFO_IMPORT_LOG', JSON.stringify(log.concat(out.map(function (x) { return nowText_() + ' ' + x; })).slice(-120))); _props = null;
+    try { logAdmin_(a, '기사 정보 빈 칸 채우기', job.length + '명', out.join(' / ').slice(0, 400)); } catch (e) { /* 무시 */ }
+    return out.length;
+  } finally { lock.releaseLock(); }
