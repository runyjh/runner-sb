+ */
+function seenSchReset_() {
+  if (props_().SEEN_SCH_RESET) return 0;
+  const lock = scriptLock_();
+  lock.waitLock(20000);
+  try {
+    if (props_().SEEN_SCH_RESET) return 0;
+    const rows = readAll_(SH.SEEN).filter(function (o) { return o.kind === SEEN_KIND.SCH && o._row; }).map(function (o) { return o._row; });
+    if (rows.length) delRows_(sheet_(SH.SEEN), rows);
+    PropertiesService.getScriptProperties().setProperty('SEEN_SCH_RESET', nowText_() + ' · ' + rows.length); _props = null;
+    return rows.length;
+  } finally { lock.releaseLock(); }
+}
